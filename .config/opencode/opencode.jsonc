{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "edit": "ask",
    "bash": {
      "*": "ask",
      "git diff": "allow",
      "cat *": "allow",
      "grep *": "allow",
      "find *": "allow",
      "rg *": "allow",
      "ls *": "allow",
      "rm *": "deny",
      "pnpm type-check *": "allow",
      "pnpm tsc *": "allow",
    },
  },
  "lsp": true,
  "mcp": {
    "exa": {
      "type": "remote",
      "url": "https://mcp.exa.ai/mcp",
      "enabled": true,
    },
  },
  "plugin": ["@dietrichgebert/ponytail"],
  "provider": {
    "llama.cpp": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "llama-server (local)",
      "options": {
        "baseURL": "http://192.168.1.116:8080/v1",
      },
      "models": {
        "unsloth/Devstral-Small-2-24B-Instruct-2512-GGUF:Q4_K_M": {
          "name": "Unsloth Devstral Small 2 24B",
          "limit": {
            "context": 256000,
            "output": 65536,
          },
        },
      },
    },
  },
}

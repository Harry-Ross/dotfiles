{
  "layer": "top",
  "exclusive": true,
  "position": "top",
  "reload_style_on_change": true,

  "modules-left": ["hyprland/workspaces"],
  "modules-center": ["clock", "hyprland/window", "idle_inhibitor"],
  "modules-right": [
    "bluetooth",
    "network",
    "tray",
    "pulseaudio",
    "backlight",
    "temperature",
    "battery",
    "custom/power"
  ],

  "hyprland/workspaces": {
    "format": "{icon} {windows}",
    "window-rewrite": {
      "code": "󰨞",
      "discord": "󰙯",
      "firefox": "",
      "notion": "",
      "alacritty": "",
      "kitty": "",
      "spotify": "",
      "steam": "",
      "zen": "",
      "zotero": "󰬇"
    }
  },
  "hyprland/window": {
    "format": "  {}",
    "separate-outputs": true,
    "max-length": 64,
    "rewrite": {
      "(.*)zsh": "> [$1]",
      "(.*)fish": "> [$1]",
      "(.*)nvim(.*)": "Neovim ",
      "(.*)Mozilla Firefox": "Firefox 󰈹",
      "(.*)Google Chrome": "Chrome ",
      "(.*)Visual Studio Code - Insiders": "Code 󰨞",
      "(.*)Dolphin": "$1 󰉋",
      "(.*)Spotify": "Spotify 󰓇",
      "(.*)Steam": "Steam 󰓓",
      "(.*)Zen Browser": "Zen 󰈹"
    }
  },
  "network": {
    "format-wifi": "{signalStrength}% ",
    "format-ethernet": "󰛳",
    "format-disconnected": "󰅛",
    "on-click": "nmcli device wifi rescan"
  },
  "clock": {
    "format": "{:%H:%M}",
    "tooltip-format": "<big>{:%A %d %B}</big>\n<tt><small>{calendar}</small></tt>",
    "format-alt": " {:%H:%M    %d/%m}"
  },
  "pulseaudio": {
    "format": "{volume}% {icon} ",
    "format-bluetooth": "{volume}% {icon} {format_source}",
    "format-bluetooth-muted": " {icon} {format_source}",
    "format-muted": "0% {icon} ",
    "format-source": "{volume}% ",
    "format-source-muted": "",
    "format-icons": {
      "headphone": "",
      "hands-free": "",
      "headset": "",
      "phone": "",
      "portable": "",
      "car": "",
      "default": ["", "", ""]
    },
    "on-click": "alacritty -e wiremix"
  },
  "temperature": {
    "format": "{temperatureC}°C ",
    "critical-threshold": 90,
    "hwmon-path-abs": "/sys/devices/platform/coretemp.0/hwmon",
    "input-filename": "temp1_input",
    "interval": 10
  },
  "custom/power": {
    "format": " ",
    "on-click": "~/.config/rofi/powermenu/type-2/powermenu.sh"
  },
  "battery": {
    "format": "{capacity}% {icon}",
    "states": { "warning": 30, "critical": 15 },
    "format-icons": ["", "", "", "", ""]
  },
  "backlight": {
    "format": "{percent}% {icon}",
    "format-icons": ["", ""]
  },
  "bluetooth": {
    "on-click": "alacritty -e bluetui",
    "format": "",
    "format-connected": " {device_alias}",
    "format-connected-battery": " {device_alias} {device_battery_percentage}%",
    "format-no-controller": "",
    // "format-device-preference": [ "device1", "device2" ], // preference list deciding the displayed device
    "tooltip-format": "{controller_alias}\t{controller_address}\n\n{num_connections} connected",
    "tooltip-format-connected": "{controller_alias}\t{controller_address}\n\n{num_connections} connected\n\n{device_enumerate}",
    "tooltip-format-enumerate-connected": "{device_alias}\t{device_address}",
    "tooltip-format-enumerate-connected-battery": "{device_alias}\t{device_address}\t{device_battery_percentage}%"
  },
  "idle_inhibitor": {
    "format": "{icon}",
    "format-icons": {
      "activated": "",
      "deactivated": ""
    }
  }
}
